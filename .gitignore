# rummy's TWA packaging folder: keep twa-manifest.json (no secrets) tracked so CI
# can read it, but never the signing key, prebuilt binaries, or Play Store zip.
rummy/android-twa/*.apk
rummy/android-twa/*.aab
rummy/android-twa/*.zip
rummy/android-twa/Readme.html
rummy/android-twa/app/
rummy/android-twa/manifest-checksum.txt
