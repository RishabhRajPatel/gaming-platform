# ---- Core ----
APP_ENV=development
APP_NAME=deals-rummy
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# ---- Database ----
POSTGRES_USER=rummy
POSTGRES_PASSWORD=rummy
POSTGRES_DB=rummy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL (overrides the parts above if set)
DATABASE_URL=postgresql+psycopg://rummy:rummy@localhost:5432/rummy

# ---- Redis (websocket pub/sub + cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- Razorpay (real-money) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Set to false to disable real money and run virtual-chips only
REAL_MONEY_ENABLED=true

# ---- Game defaults ----
GAME_MIN_PLAYERS=2
GAME_MAX_PLAYERS=4
GAME_DEFAULT_DEALS=2
GAME_TURN_SECONDS=30
GAME_STARTING_CHIPS=160

# ---- CORS / frontend ----
FRONTEND_ORIGIN=http://localhost:5173
